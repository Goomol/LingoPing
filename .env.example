# ==============================================================================
# LingoPing - Environment & Secret Credentials Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Duplicate this file as `.env`:
#      cp .env.example .env
#    Or run:
#      npm run env:setup
# 2. Add your keys below and save.
# 3. This file is git-ignored (.gitignore) and will never be committed or shared.
# 4. Verify your setup anytime with:
#      npm run env:check
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLOUD DATABASE (Central visual cache & multi-device sync)
# ------------------------------------------------------------------------------
# SAFE TO SHARE: The Project URL and Publishable Key (or legacy Anon Key).
# They are designed to be public-facing and are protected by Row Level Security (RLS).
# (Found in your Supabase Dashboard: Project Settings > API Keys)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# NEW Supabase Publishable Key format (recommended, starts with `sb_publishable_`):
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# (Or Legacy JWT Anon Key format):
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SECRET: Supabase Secret Key (starts with `sb_secret_` or legacy `service_role`)
# WARNING: NEVER share or bundle into client code. Used ONLY for automated
# backend database migrations or seed scripts executed directly by Node.js.
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 2. AI BRING-YOUR-OWN-KEY (BYOK) PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# If omitted, LingoPing defaults to free zero-key Pollinations AI + Web Speech API.
# Supplying keys below enables advanced neural speech and GPT/Claude analysis.

# OpenAI API Key (used for GPT-4o-mini structured linguistic analysis & smart drills)
VITE_OPENAI_API_KEY=sk-proj-...

# Anthropic Claude API Key (used for Claude 3.5 Haiku grammatical reasoning)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (used for Gemini neural analysis & speech)
VITE_GEMINI_API_KEY=AIzaSy...
